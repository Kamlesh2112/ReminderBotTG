# Telegram Bot Token from @BotFather (Required)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Google Gemini API Key (Optional: unlocks full LLM parsing for conversational reminders)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Optional: override the SQLite database path.
# On Render, point this at a persistent disk path (e.g. /var/data/followups.db),
# or mount the disk at /app/data and leave this empty.
REMINDER_DB_PATH=
